      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": {
            "type": "graphite",
            "uid": "${DS_GRAPHITE}"
          },
          "refId": "A",
          "target": "aliasByNode(stats.timers.ffxiv-census.http.api_v1_*.upper_95, 4)"
