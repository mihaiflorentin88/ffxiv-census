          "editorMode": "code",
          "expr": "sum by (path, status) (rate(http_requests_total{job=~\"ffxiv-census.*\",path=~\"/docs.*\"}[1m]))",
          "legendFormat": "{{path}} ({{status}})",
          "range": true,
