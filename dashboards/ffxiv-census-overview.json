          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"ffxiv-census.*\"}[5m])) by (le))",
          "legendFormat": "P95 Latency",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "P95 Request Latency",
