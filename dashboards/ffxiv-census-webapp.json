      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (result) (increase(ui_stats_refresh_total{job=~\"ffxiv-census.*\"}[6h]))",
          "legendFormat": "{{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Statistics Refresh Outcomes (6h)",
      "type": "timeseries"
